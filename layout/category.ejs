<%#

this page will judge whether current page is 'category.'
url:'http://localhost:4000/category/' return false.
url:'http://localhost:4000/categories/test/' return true.

if you enter 'category' page by click link will show all categories.
otherwise if you enter 'categories' by click post header link will show the single category of this post.

how to add a category page:

    1. hexo new page "category"
    2. cd source/category/index.md
    3. add layout pattern like this:
    ---
    title: '''category'''
    date: 2019-06-09 09:56:49
    layout: category
    ---

 %>

<%

// site.categories 是一棵树（c.parent 指向父级 _id），迭代收集 cat 自身 + 全部子孙分类的 _id
function getCategoryTreeIds(cat, allCats) {
    const ids = new Set([cat._id]);
    let found = true;
    while (found) {
        found = false;
        for (let i = 0; i < allCats.length; i++) {
            const child = allCats[i];
            if (child.parent && ids.has(child.parent) && !ids.has(child._id)) {
                ids.add(child._id);
                found = true;
            }
        }
    }
    return ids;
}

// 只取直接子级，用于渲染二级分类链接
function getDirectSubCategories(cat, allCats) {
    return allCats.filter(c => c.parent === cat._id);
}

// cat 自身 + 全部子孙分类下的文章；按 category 的 _id 判断，不依赖 categories 数组的顺序
function getCategoryPosts(cat, allCats) {
    const ids = getCategoryTreeIds(cat, allCats);
    return (cat.posts || []).filter(post => {
        if (!post.categories) return false;
        const cats = post.categories.toArray ? post.categories.toArray() : post.categories;
        return cats.some(c => ids.has(c._id));
    });
}

const allCats = site.categories.toArray ? site.categories.toArray() : site.categories;
%>

<% if (!is_category()) { %>

    <div class="container">
        <div class="post-wrap categories">
            <h2 class="post-title">-&nbsp;分类&nbsp;-</h2>
            <div class="categories-card">
                <% allCats.filter(c => !c.parent).forEach(cat => { %>
                    <div class="card-item">
                        <div class="categories">
                            <a href="<%- url_for(cat.path) %>">
                                <h3>
                                    <i class="iconfont icon-category" style="padding-right:3px"></i>
                                    <%- cat.name %>
                                </h3>
                            </a>
                            <% const subCats = getDirectSubCategories(cat, allCats); %>
                            <% if (subCats.length > 0) { %>
                                <div class="sub-category-wrap">
                                    <% subCats.forEach(subCat => { %>
                                        <a class="sub-category-link" href="<%- url_for(subCat.path) %>">
                                            <i class="iconfont icon-category"></i><%- subCat.name %>
                                        </a>
                                    <% }); %>
                                </div>
                            <% } %>
                            <% const catPosts = getCategoryPosts(cat, allCats); %>
                            <% catPosts.slice(0, 5).forEach(post_item => { %>
                                <article class="archive-item">
                                    <a class="archive-item-link"
                                       href="<%- url_for(post_item.path) %>"><%- post_item.title %></a>
                                </article>
                            <% }); %>
                            <% if (catPosts.length > 5) { %>
                                <a class="more-post-link" href="<%- url_for(cat.path) %>">更多&gt;&gt;</a>
                            <% } %>
                        </div>
                    </div>
                <% }); %>
            </div>
        </div>
    </div>

<% } else { %>

    <%# 分类工具函数只有这一份定义，通过 partial locals 传给 _page/category 复用 %>
    <%- partial('_page/category', {
        pagination: config.category,
        index: true,
        getDirectSubCategories: getDirectSubCategories,
        getCategoryPosts: getCategoryPosts
    }) %>

<% } %>
