<header>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-header header-logo">
        <a href="<%- config.root %>"><%= theme.navname %></a>
      </div>
      <div class="menu navbar-right">
        <!-- 在电脑端的导航链接区域添加搜索功能 -->
        <div class="search-container" data-root="<%- config.root %>">
          <button
            type="button"
            class="search-icon-btn"
            aria-label="搜索"
            onclick="toggleSearchInput()"
          >
            🔍
          </button>
          <input
            type="text"
            id="nav-search-input-desktop"
            class="nav-search-input"
            placeholder="想知道我什么秘密呢，搜搜看吧"
            oninput="navSearch(this)"
          />
          <button class="clear-search" onclick="clearSearch(this)">×</button>
          <div id="nav-search-result-desktop" class="nav-search-result"></div>
        </div>

        <a
          class="nav-back"
          href="<%- config.root %>"
          aria-label="返回上一页"
          onclick="return navBack()"
        >
          <svg class="nav-back-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
          </svg>
          <span>返回</span>
        </a>

        <% for (var i in theme.nav){ %>
        <a class="menu-item" href="<%- url_for(theme.nav[i]) %>"><%= i %></a>
        <% } %>

        <input id="switch_default" type="checkbox" class="switch_default" />
        <label for="switch_default" class="toggleBtn"></label>
      </div>
    </div>
  </nav>

  <%# mobile %>
  <nav class="navbar-mobile" id="nav-mobile">
    <div class="container">
      <div class="navbar-header">
        <div>
          <a href="<%- config.root %>"><%= theme.navname %></a
          ><a id="mobile-toggle-theme">·&nbsp;Light</a>
        </div>

        <div class="navbar-actions">
          <a
            class="nav-back"
            href="<%- config.root %>"
            aria-label="返回上一页"
            onclick="return navBack()"
          >
            <svg class="nav-back-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
            </svg>
          </a>
          <div class="menu-toggle" onclick="mobileBtn()">
          <svg
            class="menu-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
          >
            <path
              fill="currentColor"
              d="M4.5 17.27q-.213 0-.356-.145T4 16.768t.144-.356t.356-.143h15q.213 0 .356.144q.144.144.144.357t-.144.356t-.356.143zm0-4.77q-.213 0-.356-.144T4 11.999t.144-.356t.356-.143h15q.213 0 .356.144t.144.357t-.144.356t-.356.143zm0-4.77q-.213 0-.356-.143Q4 7.443 4 7.23t.144-.356t.356-.143h15q.213 0 .356.144T20 7.23t-.144.356t-.356.144z"
            />
          </svg>
          <svg
            class="close-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
          >
            <!-- Icon from Material Symbols Light by Google - https://github.com/google/material-design-icons/blob/master/LICENSE -->
            <path
              fill="currentColor"
              d="m12 12.708l-5.246 5.246q-.14.14-.344.15t-.364-.15t-.16-.354t.16-.354L11.292 12L6.046 6.754q-.14-.14-.15-.344t.15-.364t.354-.16t.354.16L12 11.292l5.246-5.246q.14-.14.345-.15q.203-.01.363.15t.16.354t-.16.354L12.708 12l5.246 5.246q.14.14.15.345q.01.203-.15.363t-.354.16t-.354-.16z"
            />
          </svg>
          </div>
        </div>
      </div>

      <div class="menu" id="mobile-menu">
        <% for (var i in theme.nav){ %>
        <a class="menu-item" href="<%- url_for(theme.nav[i]) %>"><%= i %></a>
        <% } %>
        <!-- 手机模式搜索框 -->
        <div
          class="search-container mobile-container"
          data-root="<%- config.root %>"
        >
          <button
            type="button"
            class="search-icon-btn menu-item"
            aria-label="搜索"
            onclick="toggleSearchInput()"
          >
            🔍
          </button>
          <input
            type="text"
            id="nav-search-input-mobile"
            class="nav-search-input"
            placeholder="想知道我什么秘密呢，搜搜看吧"
            oninput="navSearch(this)"
          />
          <button class="clear-search" onclick="clearSearch(this)">×</button>
          <div id="nav-search-result-mobile" class="nav-search-result"></div>
        </div>
      </div>
    </div>
  </nav>
</header>
<script src="<%- url_for('/js/search.js') %>" defer></script>
<script>
  // 目录小节的锚点链接（href="#标题"）会给浏览器留一条同文档历史记录，
  // history.back() 于是退回跳转前的滚动位置，而不是「上一个页面」。
  // 这里直接回到 document.referrer（同源的上一个页面）；没有同源来源时返回 true，
  // 由 <a> 的 href（站点首页）兜底。
  function navBack() {
    var ref = document.referrer.split('#')[0];
    var self = location.href.split('#')[0];
    if (ref && ref !== self && ref.indexOf(location.origin + '/') === 0) {
      location.href = ref;
      return false;
    }
    return true;
  }
</script>
