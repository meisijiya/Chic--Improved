<button type="button" class="toc-mobile-fab" aria-label="打开文章目录" aria-expanded="false" onclick="toggleMobileToc()">
  <span class="toc-mobile-icon" aria-hidden="true">☰</span>
</button>

<div class="toc-mobile-overlay" onclick="toggleMobileToc()"></div>

<div class="toc-mobile-drawer">
  <div class="toc-mobile-header">
    <span class="toc-mobile-title">目录</span>
  </div>
  <!-- 目录内容由 _partial/toc.ejs 里的 tocbot 实例渲染，按视口宽度搬进/搬出这里 -->
  <div class="tocbot-list-mobile"></div>
</div>

<script>
  function toggleMobileToc() {
    var overlay = document.querySelector('.toc-mobile-overlay');
    var drawer = document.querySelector('.toc-mobile-drawer');
    var fab = document.querySelector('.toc-mobile-fab');

    if (overlay.classList.contains('active')) {
      overlay.classList.remove('active');
      drawer.classList.remove('active');
      fab.classList.remove('active');
      fab.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    } else {
      overlay.classList.add('active');
      drawer.classList.add('active');
      fab.classList.add('active');
      fab.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
  }

  // 点抽屉里的目录项时先收起抽屉，再由 tocbot 做平滑滚动。
  // 监听挂在 document 的捕获阶段：它早于 tocbot 挂在 body 上的冒泡监听，
  // 这样抽屉关掉、body 的 overflow 复位之后，滚动目标才是最终布局里的位置。
  document.addEventListener('click', function (e) {
    var link = e.target && e.target.closest
      ? e.target.closest('.tocbot-list-mobile .toc-link')
      : null;
    if (!link) return;
    var overlay = document.querySelector('.toc-mobile-overlay');
    if (overlay && overlay.classList.contains('active')) toggleMobileToc();
  }, true);
</script>